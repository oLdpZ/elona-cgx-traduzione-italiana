{"firma": "974ac0561ea00c174942bcb32e2db66f6b149d5e", "file": "db_creature.hsp", "riga": 99590, "occorrenza": 0, "jp": "「暁の女神アウラ…その名をどうやら俺は知っているようだ」", "jp_grezzo": "\"「暁の女神アウラ…その名をどうやら俺は知っているようだ」\"", "en": "Aura, Goddess of the Dawn... I seem to know that name.", "en_grezzo": "cnvtalk(\"Aura, Goddess of the Dawn... I seem to know that name.\")", "tipo": "statica", "contesto": "", "it": "Aura, dea dell'alba... quel nome, a quanto pare, lo conosco."}
{"firma": "a2387b2df85de04e5e41fee962352b5e3ebde9db", "file": "db_creature.hsp", "riga": 99590, "occorrenza": 0, "jp": "「俺はあなたが好きだ。あなたは俺のたったひとりの姫だ。可愛いシルヴィア」", "jp_grezzo": "\"「俺はあなたが好きだ。あなたは俺のたったひとりの姫だ。可愛いシルヴィア」\"", "en": "I love you. You are the only princess for me, my precious Silvia.", "en_grezzo": "cnvtalk(\"I love you. You are the only princess for me, my precious Silvia.\")", "tipo": "statica", "contesto": "", "it": "Io ti amo. Sei la mia unica principessa. Dolce <Silvia>."}
{"firma": "e7109452214a5ac15c2451bbbc869f57b18303d8", "file": "db_creature.hsp", "riga": 99590, "occorrenza": 0, "jp": "「子供たちよ戦え、そして希望しろ」", "jp_grezzo": "\"「子供たちよ戦え、そして希望しろ」\"", "en": "Fight, children. For your future.", "en_grezzo": "cnvtalk(\"Fight, children. For your future.\")", "tipo": "statica", "contesto": "", "it": "Combattete, figli, e sperate."}
{"firma": "1353994451a909fcca1b8283b3803aaeceacebce", "file": "db_creature.hsp", "riga": 99590, "occorrenza": 0, "jp": "「俺は自分が何者で、この仮面は何故かを、つきとめねばならん」", "jp_grezzo": "\"「俺は自分が何者で、この仮面は何故かを、つきとめねばならん」\"", "en": "Who I am, and why I have this mask upon my face, is something I must find out.", "en_grezzo": "cnvtalk(\"Who I am, and why I have this mask upon my face, is something I must find out.\")", "tipo": "statica", "contesto": "", "it": "Devo scoprire chi sono e perché porto questa maschera."}
{"firma": "c9db090eb17acf83dc632380810abd9f1a471a81", "file": "db_creature.hsp", "riga": 99590, "occorrenza": 0, "jp": "「俺は…誰だ…？」", "jp_grezzo": "\"「俺は…誰だ…？」\"", "en": "Who... Who am I...?", "en_grezzo": "cnvtalk(\"Who... Who am I...?\")", "tipo": "statica", "contesto": "", "it": "Io... chi sono...?"}
{"firma": "0c68cdc95abf9858f00a7a1f18214153b5dd0d43", "file": "db_creature.hsp", "riga": 99590, "occorrenza": 0, "jp": "「ヤーンがそう望むのなら」", "jp_grezzo": "\"「ヤーンがそう望むのなら」\"", "en": "Janus' will be done.", "en_grezzo": "cnvtalk(\"Janus' will be done.\")", "tipo": "statica", "contesto": "", "it": "Se questa è la volontà di Janus."}
{"firma": "c9492cd8703a06764c9b19f67733253e6062e638", "file": "db_creature.hsp", "riga": 99596, "occorrenza": 0, "jp": "「ヤーンがそう望むならば仕方あるまい」", "jp_grezzo": "\"「ヤーンがそう望むならば仕方あるまい」\"", "en": "As Janus wishes.", "en_grezzo": "cnvtalk(\"As Janus wishes.\")", "tipo": "statica", "contesto": "", "it": "Se Janus vuole così, non c'è niente da fare."}
{"firma": "89018e4a5aa14d3d7567f8377ce84d2be734301a", "file": "db_creature.hsp", "riga": 99596, "occorrenza": 0, "jp": "「ガルルル」", "jp_grezzo": "\"「ガルルル」\"", "en": "Grrrr!", "en_grezzo": "cnvtalk(\"Grrrr!\")", "tipo": "statica", "contesto": "", "it": "*grrrr*"}
{"firma": "f2ec582f6c5fb5e084b4bc0c084079539c0126d2", "file": "db_creature.hsp", "riga": 99596, "occorrenza": 0, "jp": "「ドールめ！」", "jp_grezzo": "\"「ドールめ！」\"", "en": "You dog!", "en_grezzo": "cnvtalk(\"You dog!\")", "tipo": "statica", "contesto": "", "it": "Brutto cane!"}
{"firma": "a6c81eec360e283daa8374afd9a316df965017c3", "file": "db_creature.hsp", "riga": 99596, "occorrenza": 0, "jp": "「追い詰められたトルクに噛まれぬよう、気をつけなければな」", "jp_grezzo": "\"「追い詰められたトルクに噛まれぬよう、気をつけなければな」\"", "en": "Careful you don't bite off more than you can chew.", "en_grezzo": "cnvtalk(\"Careful you don't bite off more than you can chew.\")", "tipo": "statica", "contesto": "", "it": "Attento a non farti mordere da un torque messo alle strette."}
{"firma": "62acaa5325ab2cac5dc2db44b558aab9545d4df2", "file": "db_creature.hsp", "riga": 99608, "occorrenza": 0, "jp": "「ヤヌスのみ心のままに」", "jp_grezzo": "\"「ヤヌスのみ心のままに」\"", "en": "Let Janus decide your fate.", "en_grezzo": "cnvtalk(\"Let Janus decide your fate.\")", "tipo": "statica", "contesto": "", "it": "Sia fatta la volontà di Janus."}
{"firma": "36422a83439f87ea64db7d0345842a9242f3e616", "file": "db_creature.hsp", "riga": 99608, "occorrenza": 0, "jp": "「ヤーンは与えたまい、また奪いたまう」", "jp_grezzo": "\"「ヤーンは与えたまい、また奪いたまう」\"", "en": "As Janus giveth, so too does Janus taketh away.", "en_grezzo": "cnvtalk(\"As Janus giveth, so too does Janus taketh away.\")", "tipo": "statica", "contesto": "", "it": "Janus dà, e Janus toglie."}
