{"firma": "6d06b32dbc6752331654c38e64e1bbb9cf38304b", "file": "db_creature.hsp", "riga": 95431, "occorrenza": 0, "jp": "「やりましたね、かたつむり様」", "jp_grezzo": "\"「やりましたね、かたつむり様」\"", "en": "It's done, Lord Snail.", "en_grezzo": "cnvtalk(\"It's done, Lord Snail.\")", "tipo": "statica", "contesto": "", "it": "Ce l'abbiamo fatta, <Lumaca>."}
{"firma": "41cbf6e12d39d3b1a040acb3dfecaebe98b3d8a3", "file": "db_creature.hsp", "riga": 95431, "occorrenza": 0, "jp": "「背負っているものが違うのさ」", "jp_grezzo": "\"「背負っているものが違うのさ」\"", "en": "You've got some interesting stuff here.", "en_grezzo": "cnvtalk(\"You've got some interesting stuff here.\")", "tipo": "statica", "contesto": "", "it": "È diverso, quello che ci si porta sulla schiena."}
{"firma": "b0e2006f43b00011aabeecf1370c32a2caf0c137", "file": "db_creature.hsp", "riga": 100593, "occorrenza": 0, "jp": "「なによ！さ、寂しくなんてなかったんだからね！」", "jp_grezzo": "\"「なによ！さ、寂しくなんてなかったんだからね！」\"", "en": "What! I, I didn't miss you or anything!", "en_grezzo": "cnvtalk(\"What! I, I didn't miss you or anything!\")", "tipo": "statica", "contesto": "", "it": "E che c'è! N-non è che mi mancassi, eh!"}
{"firma": "e37bdc7cc8f674cebf737b7aa03085e713a5d1bd", "file": "db_creature.hsp", "riga": 100599, "occorrenza": 0, "jp": "「…ごめん」", "jp_grezzo": "\"「…ごめん」\"", "en": "...Sorry", "en_grezzo": "cnvtalk(\"...Sorry\")", "tipo": "statica", "contesto": "", "it": "...scusa."}
{"firma": "662e389b72fa4405e39c44bd0a4b51d9afd10f06", "file": "db_creature.hsp", "riga": 100599, "occorrenza": 0, "jp": "「なんなのよ、もう」", "jp_grezzo": "\"「なんなのよ、もう」\"", "en": "What are you thinking!", "en_grezzo": "cnvtalk(\"What are you thinking!\")", "tipo": "statica", "contesto": "", "it": "Ma insomma, che modi."}
{"firma": "8f12d595b4d243bb80c57b1614a5cfc634606b71", "file": "db_creature.hsp", "riga": 100761, "occorrenza": 0, "jp": "「手土産のひとつくらいあるんでしょうね」", "jp_grezzo": "\"「手土産のひとつくらいあるんでしょうね」\"", "en": "I bet you have at least one souvenir for me.", "en_grezzo": "cnvtalk(\"I bet you have at least one souvenir for me.\")", "tipo": "statica", "contesto": "", "it": "Un pensierino ce l'avrai, spero."}
{"firma": "3819f75b07ac8561ba12306ce98707b08f432426", "file": "db_creature.hsp", "riga": 100767, "occorrenza": 0, "jp": "「アハハ！お望み通り、ミンチにしてあげたわよ」", "jp_grezzo": "\"「アハハ！お望み通り、ミンチにしてあげたわよ」\"", "en": "Ahaha! As you wish, I've minced you.", "en_grezzo": "cnvtalk(\"Ahaha! As you wish, I've minced you.\")", "tipo": "statica", "contesto": "", "it": "Ahahah! Come volevi, ti ho ridotto in poltiglia."}
{"firma": "570dbbf92da931d39c10e5a1e2bf5b2bb670a1d1", "file": "db_creature.hsp", "riga": 100767, "occorrenza": 0, "jp": "「風に逆らうなんて愚かね」", "jp_grezzo": "\"「風に逆らうなんて愚かね」\"", "en": "It would be foolish to go against the wind.", "en_grezzo": "cnvtalk(\"It would be foolish to go against the wind.\")", "tipo": "statica", "contesto": "", "it": "Che sciocchezza, mettersi contro il vento."}
