{"firma": "063824809159e53c4bc7a7fda84b22a520018040", "file": "db_creature.hsp", "riga": 77943, "occorrenza": 0, "jp": "「これが君の運命だよ」", "jp_grezzo": "\"「これが君の運命だよ」\"", "en": "This is your destiny.", "en_grezzo": "cnvtalk(\"This is your destiny.\")", "tipo": "statica", "contesto": "", "it": "Questo è il tuo destino."}
{"firma": "541f0e613cca52b43bfd8da8e64d6aa9627d5890", "file": "db_creature.hsp", "riga": 80136, "occorrenza": 0, "jp": "「ふっ、なかなか愉快な反応だ」", "jp_grezzo": "\"「ふっ、なかなか愉快な反応だ」\"", "en": "Huh, that's a pretty funny thing to do.", "en_grezzo": "cnvtalk(\"Huh, that's a pretty funny thing to do.\")", "tipo": "statica", "contesto": "", "it": "Hmpf, una reazione piuttosto divertente."}
{"firma": "f0ae589cbc8890cbae09a47234a9ce2c97d02a3d", "file": "db_creature.hsp", "riga": 80136, "occorrenza": 0, "jp": "「苦しいか？苦しいだろうな」", "jp_grezzo": "\"「苦しいか？苦しいだろうな」\"", "en": "Are you hurt? I'm sure you're hurt.", "en_grezzo": "cnvtalk(\"Are you hurt? I'm sure you're hurt.\")", "tipo": "statica", "contesto": "", "it": "Soffri? Certo che soffri."}
{"firma": "67a78e3e9f23f8c74dfee2995674d5b771da4719", "file": "db_creature.hsp", "riga": 80136, "occorrenza": 0, "jp": "「救済してやろう」", "jp_grezzo": "\"「救済してやろう」\"", "en": "I'll save you.", "en_grezzo": "cnvtalk(\"I'll save you.\")", "tipo": "statica", "contesto": "", "it": "Ti concederò la salvezza."}
{"firma": "dbde02ab579aa0c681c5af83a4bdf4d129ab7c90", "file": "db_creature.hsp", "riga": 80142, "occorrenza": 0, "jp": "「愚か者め…」", "jp_grezzo": "\"「愚か者め…」\"", "en": "Fool...", "en_grezzo": "cnvtalk(\"Fool...\")", "tipo": "statica", "contesto": "", "it": "Che stoltezza..."}
{"firma": "226d728bd5968d392a3f36ac366ed9f46c9747bb", "file": "db_creature.hsp", "riga": 80142, "occorrenza": 0, "jp": "「悪夢かこれは？」", "jp_grezzo": "\"「悪夢かこれは？」\"", "en": "Is this a nightmare?", "en_grezzo": "cnvtalk(\"Is this a nightmare?\")", "tipo": "statica", "contesto": "", "it": "È un incubo, questo?"}
{"firma": "18ff78823689ed3bf78418cee3414c1c433aa8d5", "file": "db_creature.hsp", "riga": 80148, "occorrenza": 0, "jp": "「少しは学んだか？」", "jp_grezzo": "\"「少しは学んだか？」\"", "en": "Have you learned a thing or two?", "en_grezzo": "cnvtalk(\"Have you learned a thing or two?\")", "tipo": "statica", "contesto": "", "it": "Hai imparato qualcosa?"}
{"firma": "2628af1d8069a1e4ad891b507b1f665e4ced7ec1", "file": "db_creature.hsp", "riga": 80148, "occorrenza": 0, "jp": "「おまえの顔はもう見飽きた」", "jp_grezzo": "\"「おまえの顔はもう見飽きた」\"", "en": "I'm tired of seeing your face.", "en_grezzo": "cnvtalk(\"I'm tired of seeing your face.\")", "tipo": "statica", "contesto": "", "it": "La tua faccia, ormai, l'ho vista abbastanza."}
