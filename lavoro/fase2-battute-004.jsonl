{"firma": "13bb1ac81e93bd0f3562c1bfa0e0a5a045fea8f2", "file": "db_creature.hsp", "riga": 50914, "occorrenza": 0, "jp": "「年季物のクリムエールがあるよ」", "jp_grezzo": "\"「年季物のクリムエールがあるよ」\"", "en": "We got vintage crim ales.", "en_grezzo": "cnvtalk(\"We got vintage crim ales.\")", "tipo": "statica", "contesto": "", "it": "Abbiamo birre crim d'annata."}
{"firma": "bab062f44d41859d157b84c8f66990b71a0dc276", "file": "db_creature.hsp", "riga": 50920, "occorrenza": 0, "jp": "「この酔っ払いめ！」", "jp_grezzo": "\"「この酔っ払いめ！」\"", "en": "Hey, stop it drunkard.", "en_grezzo": "cnvtalk(\"Hey, stop it drunkard.\")", "tipo": "statica", "contesto": "", "it": "Ehi, piantala, hai bevuto troppo."}
{"firma": "6456822ba2ff76f106fe12ac8d7f3998fdf9e17f", "file": "db_creature.hsp", "riga": 50920, "occorrenza": 0, "jp": "「悪酔いはいけませんよ」", "jp_grezzo": "\"「悪酔いはいけませんよ」\"", "en": "Are you sick from drinking too much?", "en_grezzo": "cnvtalk(\"Are you sick from drinking too much?\")", "tipo": "statica", "contesto": "", "it": "Ti senti male per aver bevuto troppo?"}
{"firma": "896b6f85c1ce4cdd4df35881e2f2c5d8f6ac33ff", "file": "db_creature.hsp", "riga": 50926, "occorrenza": 0, "jp": "「酔っ払いごときに…」", "jp_grezzo": "\"「酔っ払いごときに…」\"", "en": "I got killed by a drunkard.", "en_grezzo": "cnvtalk(\"I got killed by a drunkard.\")", "tipo": "statica", "contesto": "", "it": "Mi ha ammazzato un ubriacone."}
{"firma": "886b108fa3e8400df32e247fb1cf0d8015f60b51", "file": "db_creature.hsp", "riga": 50926, "occorrenza": 0, "jp": "「ふざけた運命だ」", "jp_grezzo": "\"「ふざけた運命だ」\"", "en": "This is ridiculous.", "en_grezzo": "cnvtalk(\"This is ridiculous.\")", "tipo": "statica", "contesto": "", "it": "Ma è ridicolo."}
{"firma": "80ffcb200028f15f762ee8a9c41b521acfa2f334", "file": "db_creature.hsp", "riga": 50932, "occorrenza": 0, "jp": "「お帰りですか。美味い酒を用意してありますよ」", "jp_grezzo": "\"「お帰りですか。美味い酒を用意してありますよ」\"", "en": "Welcome home. I've got some decent ales for you.", "en_grezzo": "cnvtalk(\"Welcome home. I've got some decent ales for you.\")", "tipo": "statica", "contesto": "", "it": "Eccoti di ritorno. Ho delle birre discrete per te."}
{"firma": "4ea39705b981f31d1e5aeeabc7fd56c461d6576b", "file": "db_creature.hsp", "riga": 50932, "occorrenza": 0, "jp": "「お疲れだったでしょう。冷酒でもどうですか」", "jp_grezzo": "\"「お疲れだったでしょう。冷酒でもどうですか」\"", "en": "Are you tired? How'bout a drink?", "en_grezzo": "cnvtalk(\"Are you tired? How'bout a drink?\")", "tipo": "statica", "contesto": "", "it": "Sei a pezzi? Che ne dici di un bicchiere?"}
{"firma": "5fe426acf1a3bbf6123a33df856950172ba1d459", "file": "db_creature.hsp", "riga": 50938, "occorrenza": 0, "jp": "「酔いは覚めましたか？」", "jp_grezzo": "\"「酔いは覚めましたか？」\"", "en": "Sober up now huh?", "en_grezzo": "cnvtalk(\"Sober up now huh?\")", "tipo": "statica", "contesto": "", "it": "Adesso ti sei schiarito le idee, eh?"}
{"firma": "f066d9f727e88d6d2a833f731bf3235c640d85e0", "file": "db_creature.hsp", "riga": 51087, "occorrenza": 0, "jp": "「あれだけ巡ったノースティリスの地理が思い出せない…」", "jp_grezzo": "\"「あれだけ巡ったノースティリスの地理が思い出せない…」\"", "en": "I can't remember the geography of North Tyris, which I visited so many times...", "en_grezzo": "cnvtalk(\"I can't remember the geography of North Tyris, which I visited so many times...\")", "tipo": "statica", "contesto": "", "it": "Non riesco a ricordare la geografia di Tyris del Nord, che ho battuto tante volte..."}
{"firma": "a62f9fdb8046fa36404358fbbb4c4adea4502dbe", "file": "db_creature.hsp", "riga": 51087, "occorrenza": 0, "jp": "「ラスキリスにいたモンスターはどうなったんだ？」", "jp_grezzo": "\"「ラスキリスにいたモンスターはどうなったんだ？」\"", "en": "What happened to the monsters in Raskilis?", "en_grezzo": "cnvtalk(\"What happened to the monsters in Raskilis?\")", "tipo": "statica", "contesto": "", "it": "Che fine hanno fatto i mostri di Raskilis?"}
{"firma": "115f644718222f2f5df783c6b374b4716cb0b807", "file": "db_creature.hsp", "riga": 51087, "occorrenza": 0, "jp": "「知らないモンスターは警戒すべきだ」", "jp_grezzo": "\"「知らないモンスターは警戒すべきだ」\"", "en": "You should be wary of monsters you don't know.", "en_grezzo": "cnvtalk(\"You should be wary of monsters you don't know.\")", "tipo": "statica", "contesto": "", "it": "Diffida dei mostri che non conosci."}
