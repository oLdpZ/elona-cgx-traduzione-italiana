{"firma": "08522c77eaa5d65222a2301d959002ed87068a78", "file": "db_creature.hsp", "riga": 56299, "occorrenza": 0, "jp": "「散っていった同志たちよ、俺に勇気をわけてくれ」", "jp_grezzo": "\"「散っていった同志たちよ、俺に勇気をわけてくれ」\"", "en": "My departed comrades, give me courage.", "en_grezzo": "cnvtalk(\"My departed comrades, give me courage.\")", "tipo": "statica", "contesto": "", "it": "Compagni caduti, datemi coraggio."}
{"firma": "68991650c92231e9822b25d1bdd3bfaa84b308c0", "file": "db_creature.hsp", "riga": 56299, "occorrenza": 0, "jp": "「俺には人を見る目がないんだろうか…」", "jp_grezzo": "\"「俺には人を見る目がないんだろうか…」\"", "en": "Maybe I don't have the eyes to see people...", "en_grezzo": "cnvtalk(\"Maybe I don't have the eyes to see people...\")", "tipo": "statica", "contesto": "", "it": "Che non sappia giudicare le persone..."}
