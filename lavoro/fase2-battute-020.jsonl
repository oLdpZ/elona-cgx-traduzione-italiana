{"firma": "f807d66ee7e960bb2f936e956786d2d29eb6c043", "file": "db_creature.hsp", "riga": 56305, "occorrenza": 0, "jp": "「戦わずに大切なものが守れるかよ！」", "jp_grezzo": "\"「戦わずに大切なものが守れるかよ！」\"", "en": "You can't protect what's important without a fight!", "en_grezzo": "cnvtalk(\"You can't protect what's important without a fight!\")", "tipo": "statica", "contesto": "", "it": "Senza combattere non si difende ciò che conta!"}
{"firma": "19223c90b37ffed849ef85f2b63643440150dee2", "file": "db_creature.hsp", "riga": 56305, "occorrenza": 0, "jp": "「死んでも理不尽な暴力には屈しないぞ！」", "jp_grezzo": "\"「死んでも理不尽な暴力には屈しないぞ！」\"", "en": "I will not give in to unreasonable violence, even in death!", "en_grezzo": "cnvtalk(\"I will not give in to unreasonable violence, even in death!\")", "tipo": "statica", "contesto": "", "it": "Nemmeno da morto cederò alla violenza cieca!"}
