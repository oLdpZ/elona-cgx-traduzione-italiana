{"firma": "1360aa6c6e3dbc026a65f00da8e382557abf93a7", "file": "db_creature.hsp", "riga": 123567, "occorrenza": 0, "jp": "「これからの世界はカガクなのじゃ」", "jp_grezzo": "\"「これからの世界はカガクなのじゃ」\"", "en": "Science is its own reward!", "en_grezzo": "cnvtalk(\"Science is its own reward!\")", "tipo": "statica", "contesto": "", "it": "Il mondo che verrà sarà SCIENZA."}
{"firma": "d60322af7d283040329f00ee65b5fd46edcfc86e", "file": "db_creature.hsp", "riga": 123567, "occorrenza": 0, "jp": "「実験体が足りぬ」", "jp_grezzo": "\"「実験体が足りぬ」\"", "en": "With a little bit of this, and a little bit of that, why, who knows what you are going to get?", "en_grezzo": "cnvtalk(\"With a little bit of this, and a little bit of that, why, who knows what you are going to get?\")", "tipo": "statica", "contesto": "", "it": "Mi mancano cavie."}
{"firma": "24a3ec4600378012a3084a459f799f9ba4169909", "file": "db_creature.hsp", "riga": 123567, "occorrenza": 0, "jp": "「ふむふむ…この遺伝子を猫に組み込めば…」", "jp_grezzo": "\"「ふむふむ…この遺伝子を猫に組み込めば…」\"", "en": "I wonder if a black cat's genes are more or less lucky than a regular cat's...", "en_grezzo": "cnvtalk(\"I wonder if a black cat's genes are more or less lucky than a regular cat's...\")", "tipo": "statica", "contesto": "", "it": "Uhm uhm... se innestassi questo gene in un gatto..."}
{"firma": "da72e2b4ec99e48b823a987f76485c4490805846", "file": "db_creature.hsp", "riga": 123573, "occorrenza": 0, "jp": "「カガク万歳！」", "jp_grezzo": "\"「カガク万歳！」\"", "en": "Hail Saga... err, science!", "en_grezzo": "cnvtalk(\"Hail Saga... err, science!\")", "tipo": "statica", "contesto": "", "it": "Viva la SCIENZA!"}
{"firma": "96ddef2cc2dffaf54f61611e06f9361b50c2a922", "file": "db_creature.hsp", "riga": 124478, "occorrenza": 0, "jp": "「正しいことを行うのが時には難しいこともあるわ」", "jp_grezzo": "\"「正しいことを行うのが時には難しいこともあるわ」\"", "en": "The path of the righteous is not always easy, yes?", "en_grezzo": "cnvtalk(\"The path of the righteous is not always easy, yes?\")", "tipo": "statica", "contesto": "", "it": "A volte fare la cosa giusta non è facile."}
{"firma": "5ada609774afa70a15bfe087d47e5c3a084eb7c9", "file": "db_creature.hsp", "riga": 124478, "occorrenza": 0, "jp": "「私の子供達を傷つけたらひどいわよ」", "jp_grezzo": "\"「私の子供達を傷つけたらひどいわよ」\"", "en": "I'll not have him hurt my Little ones... I've worked far too long on them to see them fail now.", "en_grezzo": "cnvtalk(\"I'll not have him hurt my Little ones... I've worked far too long on them to see them fail now.\")", "tipo": "statica", "contesto": "", "it": "Guai a te se fai del male ai miei bambini."}
{"firma": "d293e7f2a5777df356a9a7dd9c52a2dad04c0092", "file": "db_creature.hsp", "riga": 124484, "occorrenza": 0, "jp": "「どうしてそんなことができるの？」", "jp_grezzo": "\"「どうしてそんなことができるの？」\"", "en": "How can you do such a thing?", "en_grezzo": "cnvtalk(\"How can you do such a thing?\")", "tipo": "statica", "contesto": "", "it": "Come puoi fare una cosa simile?"}
