{"firma": "42b644552331d96b93a2314381874a83ebd9490d", "file": "db_creature.hsp", "riga": 102696, "occorrenza": 0, "jp": "「俺様に歯向かうとはいい度胸だ」", "jp_grezzo": "\"「俺様に歯向かうとはいい度胸だ」\"", "en": "You have the courage to stand up to me.", "en_grezzo": "cnvtalk(\"You have the courage to stand up to me.\")", "tipo": "statica", "contesto": "", "it": "Ci vuole fegato per tenermi testa."}
