{"firma": "18ea7b4d3e6ddc99799904b93936c4b893fba07a", "file": "db_creature.hsp", "riga": 51257, "occorrenza": 0, "jp": "「天使は君のすぐそばに」", "jp_grezzo": "\"「天使は君のすぐそばに」\"", "en": "An Angel flew down to you.", "en_grezzo": "cnvtalk(\"An Angel flew down to you.\")", "tipo": "statica", "contesto": "", "it": "L'angelo è qui, accanto a te."}
{"firma": "58bcb5dfb36904011760b29a0919fe13d331123c", "file": "db_creature.hsp", "riga": 51257, "occorrenza": 0, "jp": "「永遠より長い夏を見てた」", "jp_grezzo": "\"「永遠より長い夏を見てた」\"", "en": "I saw a summer longer than eternity.", "en_grezzo": "cnvtalk(\"I saw a summer longer than eternity.\")", "tipo": "statica", "contesto": "", "it": "Ho visto un'estate più lunga dell'eternità."}
{"firma": "ccd8b2acc40acb668864dcb5beef1d80647bbd28", "file": "db_creature.hsp", "riga": 51257, "occorrenza": 0, "jp": "「愛に身を委ね眠りなさい」", "jp_grezzo": "\"「愛に身を委ね眠りなさい」\"", "en": "Entrust yourself to love and sleep.", "en_grezzo": "cnvtalk(\"Entrust yourself to love and sleep.\")", "tipo": "statica", "contesto": "", "it": "Abbandonati all'amore e dormi."}
{"firma": "a37e7bdbe5747ba3013519dbe51e344b5e911a93", "file": "db_creature.hsp", "riga": 51257, "occorrenza": 0, "jp": "「ありがとう、眠りなさい」", "jp_grezzo": "\"「ありがとう、眠りなさい」\"", "en": "Thank you, go to sleep.", "en_grezzo": "cnvtalk(\"Thank you, go to sleep.\")", "tipo": "statica", "contesto": "", "it": "Grazie. Adesso dormi."}
{"firma": "45883d64072752f57871833b9abb13f708f42aa7", "file": "db_creature.hsp", "riga": 51263, "occorrenza": 0, "jp": "「悪夢と言う名の鎖が奴をここに繋ぎ止めているの？」", "jp_grezzo": "\"「悪夢と言う名の鎖が奴をここに繋ぎ止めているの？」\"", "en": "Is the chain of Nightmare thats keeping you here?", "en_grezzo": "cnvtalk(\"Is the chain of Nightmare thats keeping you here?\")", "tipo": "statica", "contesto": "", "it": "È una catena che si chiama incubo, quella che lo tiene legato qui?"}
