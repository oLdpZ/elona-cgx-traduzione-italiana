{"firma": "1557f4b800e143f2ae00dd121cd844ac7359b6b0", "file": "db_creature.hsp", "riga": 121931, "occorrenza": 0, "jp": "「やばいヤマだったぜ」", "jp_grezzo": "\"「やばいヤマだったぜ」\"", "en": "Like taking candy from a baby in armor.", "en_grezzo": "cnvtalk(\"Like taking candy from a baby in armor.\")", "tipo": "statica", "contesto": "", "it": "Che colpo rischioso."}
