{"firma": "647e15e849d3a1cd4602dc7cde6c7d7f03cf7ce4", "file": "db_creature.hsp", "riga": 121660, "occorrenza": 0, "jp": "「貴様、軍事裁判にかけてやるわ」", "jp_grezzo": "\"「貴様、軍事裁判にかけてやるわ」\"", "en": "I'll put you on a trial!", "en_grezzo": "cnvtalk(\"I'll put you on a trial!\")", "tipo": "statica", "contesto": "", "it": "Ti farò passare per la corte marziale."}
