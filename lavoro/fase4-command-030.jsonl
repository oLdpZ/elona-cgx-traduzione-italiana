{"firma": "1f299b7cb3966e4f1d507f4ac799f0af6c22cfb8", "file": "command.hsp", "riga": 4758, "occorrenza": 0, "jp": "めでたいわね。", "jp_grezzo": "\"めでたいわね。\"", "en": "I wish you a Happy New Year!", "en_grezzo": "cnvtalk(\"I wish you a Happy New Year!\")", "tipo": "statica", "contesto": "", "it": "Auguri anche a te."}
{"firma": "cdd1b962f5cad290a3f6060844fa266aa364369e", "file": "command.hsp", "riga": 4764, "occorrenza": 0, "jp": "え？今年もクリスマスは中止でしょ？", "jp_grezzo": "\"え？今年もクリスマスは中止でしょ？\"", "en": "Merry Christmas!", "en_grezzo": "cnvtalk(\"Merry Christmas!\")", "tipo": "statica", "contesto": "", "it": "Eh? Ma il Natale non è stato annullato anche quest'anno?"}
