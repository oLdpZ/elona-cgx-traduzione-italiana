{"firma": "c2efd624401a2b6b63f1f0fb8770b857a1463390", "file": "action.hsp", "riga": 6429, "occorrenza": 0, "jp": "あっ！空き瓶を井戸に落としてしまった…", "jp_grezzo": "\"あっ！空き瓶を井戸に落としてしまった…\"", "en": "Oops! You drop the empty bottle into the well...", "en_grezzo": "\"Oops! You drop the empty bottle into the well...\"", "tipo": "statica", "contesto": "", "it": "Ah! Hai lasciato cadere la bottiglia vuota nel pozzo…"}
{"firma": "22b9b7bc5febb81176697b186da0e029dbafb310", "file": "action.hsp", "riga": 6461, "occorrenza": 0, "jp": "空き瓶に水をすくった。", "jp_grezzo": "\"空き瓶に水をすくった。\"", "en": "You draw water from the well into the empty bottle.", "en_grezzo": "\"You draw water from the well into the empty bottle.\"", "tipo": "statica", "contesto": "", "it": "Riempi la bottiglia vuota con l'acqua del pozzo."}
