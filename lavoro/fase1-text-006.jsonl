{"firma": "fd974be602c8fc80808808283511c09edaad248e", "file": "text.hsp", "riga": 1737, "occorrenza": 0, "jp": "一体どういうこと？", "jp_grezzo": "\"一体どういうこと？\"", "en": "What happened?", "en_grezzo": "\"What happened?\"", "tipo": "statica", "contesto": "", "it": "Che diavolo sta succedendo?"}
{"firma": "93622361ba710ded5080ba69edac1d7e5de989b4", "file": "text.hsp", "riga": 1740, "occorrenza": 0, "jp": "なんのつもりだ？", "jp_grezzo": "\"なんのつもりだ？\"", "en": "What do you intend to do?", "en_grezzo": "\"What do you intend to do?\"", "tipo": "statica", "contesto": "", "it": "Che intenzioni hai?"}
{"firma": "90b27e73199b09c691a8597224c7bcfd54182721", "file": "text.hsp", "riga": 1743, "occorrenza": 0, "jp": "騙したの！？", "jp_grezzo": "\"騙したの！？\"", "en": "You deceived me!?", "en_grezzo": "\"You deceived me!?\"", "tipo": "statica", "contesto": "", "it": "Mi stavi ingannando!?"}
{"firma": "8b86344eee215fe1aa44bc6c9d20978c7c3d0ae8", "file": "text.hsp", "riga": 1756, "occorrenza": 0, "jp": "やっぱりなんでもない", "jp_grezzo": "\"やっぱりなんでもない\"", "en": "It's nothing.", "en_grezzo": "\"It's nothing.\"", "tipo": "statica", "contesto": "", "it": "Niente, lascia perdere."}
{"firma": "7875042f6836f3b9d65479eb52cba70743c9445f", "file": "text.hsp", "riga": 1759, "occorrenza": 0, "jp": "愛している", "jp_grezzo": "\"愛している\"", "en": "I love you.", "en_grezzo": "\"I love you.\"", "tipo": "statica", "contesto": "", "it": "Ti amo."}
{"firma": "7ac5c55a7e7a098aa91923fbd78d3b7a32d2fd37", "file": "text.hsp", "riga": 1762, "occorrenza": 0, "jp": "食べちゃいたい", "jp_grezzo": "\"食べちゃいたい\"", "en": "You are so cute I could eat you up.", "en_grezzo": "\"You are so cute I could eat you up.\"", "tipo": "statica", "contesto": "", "it": "Ti mangerei di baci."}
{"firma": "80305c77c95f1040bc8e073d9519c182ae8c2026", "file": "text.hsp", "riga": 1765, "occorrenza": 0, "jp": "大好き", "jp_grezzo": "\"大好き\"", "en": "I really like you.", "en_grezzo": "\"I really like you.\"", "tipo": "statica", "contesto": "", "it": "Mi piaci tantissimo."}
{"firma": "90d3fbc1a7c5e06e0f6648e713798e88f6b209a3", "file": "text.hsp", "riga": 1768, "occorrenza": 0, "jp": "頼りにしている", "jp_grezzo": "\"頼りにしている\"", "en": "I'm in your debt.", "en_grezzo": "\"I'm in your debt.\"", "tipo": "statica", "contesto": "", "it": "Mi fido di te."}
{"firma": "41f08b91dc2e5ee8c026fd2fd48da8132919b2c3", "file": "text.hsp", "riga": 1771, "occorrenza": 0, "jp": "これからが楽しみ", "jp_grezzo": "\"これからが楽しみ\"", "en": "I'm looking forward to our future.", "en_grezzo": "\"I'm looking forward to our future.\"", "tipo": "statica", "contesto": "", "it": "Non vedo l'ora di ciò che verrà."}
{"firma": "1d69b564baa6764656cf057c9f730fbcd0a574f2", "file": "text.hsp", "riga": 1774, "occorrenza": 0, "jp": "嫌いじゃない", "jp_grezzo": "\"嫌いじゃない\"", "en": "I don't mind you.", "en_grezzo": "\"I don't mind you.\"", "tipo": "statica", "contesto": "", "it": "Non mi dispiaci."}
{"firma": "128f5b3beed943e1dc3ff6d2e1b2ec273f59d09b", "file": "text.hsp", "riga": 1777, "occorrenza": 0, "jp": "役立たず", "jp_grezzo": "\"役立たず\"", "en": "You're useless.", "en_grezzo": "\"You're useless.\"", "tipo": "statica", "contesto": "", "it": "Non servi a niente."}
{"firma": "d32ca97db32c942280a1b27a3d69348855fd663a", "file": "text.hsp", "riga": 1780, "occorrenza": 0, "jp": "キモい", "jp_grezzo": "\"キモい\"", "en": "You're disgusting.", "en_grezzo": "\"You're disgusting.\"", "tipo": "statica", "contesto": "", "it": "Fai schifo."}
