{"firma": "7027856bb8b28b454696420cb3d211fd6319b3f4", "file": "text.hsp", "riga": 1852, "occorrenza": 0, "jp": "…うまく言葉に出来ない", "jp_grezzo": "\"…うまく言葉に出来ない\"", "en": "... I can't put it into words.", "en_grezzo": "\"... I can't put it into words.\"", "tipo": "statica", "contesto": "", "it": "… Non riesco a dirlo a parole."}
{"firma": "b896fe75e02a98b6e71e77a4695194770e6b7880", "file": "text.hsp", "riga": 1855, "occorrenza": 0, "jp": "ずっと傍にいて", "jp_grezzo": "\"ずっと傍にいて\"", "en": "I want you to be with me forever.", "en_grezzo": "\"I want you to be with me forever.\"", "tipo": "statica", "contesto": "", "it": "Resta con me per sempre."}
