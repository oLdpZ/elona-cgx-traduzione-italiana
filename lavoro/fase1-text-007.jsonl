{"firma": "184e9b8dbd51f80d73f15b67be7372354fc7a4e2", "file": "text.hsp", "riga": 1804, "occorrenza": 0, "jp": "な、なんでもない！", "jp_grezzo": "\"な、なんでもない！\"", "en": "N-Nothing!", "en_grezzo": "\"N-Nothing!\"", "tipo": "statica", "contesto": "", "it": "N-Niente!"}
{"firma": "8a6c98ca044c16eb215b78d9120f80ffed6a49e1", "file": "text.hsp", "riga": 1807, "occorrenza": 0, "jp": "最高に可愛い", "jp_grezzo": "\"最高に可愛い\"", "en": "You're the cutest thing in the world.", "en_grezzo": "\"You're the cutest thing in the world.\"", "tipo": "statica", "contesto": "", "it": "Non c'è niente di più tenero di te."}
{"firma": "2ecea3a13c3c3d72edf8aa679b9ded7eb3f4b65a", "file": "text.hsp", "riga": 1810, "occorrenza": 0, "jp": "心酔しています", "jp_grezzo": "\"心酔しています\"", "en": "I'm entranced by you.", "en_grezzo": "\"I'm entranced by you.\"", "tipo": "statica", "contesto": "", "it": "Ho una devozione assoluta per te."}
{"firma": "a07d62406369bbcc9816c49c7c8f05ae41bc3c90", "file": "text.hsp", "riga": 1813, "occorrenza": 0, "jp": "すごく格好いい", "jp_grezzo": "\"すごく格好いい\"", "en": "You're so cool.", "en_grezzo": "\"You're so cool.\"", "tipo": "statica", "contesto": "", "it": "Hai un fascino incredibile."}
{"firma": "6feff7fa0c35c16bdae6ad843b632eb8b1051bb8", "file": "text.hsp", "riga": 1816, "occorrenza": 0, "jp": "心強い", "jp_grezzo": "\"心強い\"", "en": "I'm so relieved to be with you.", "en_grezzo": "\"I'm so relieved to be with you.\"", "tipo": "statica", "contesto": "", "it": "Con te mi sento al sicuro."}
{"firma": "83b4ab0b84bc38746ddc00a678ed29b533f9eaf7", "file": "text.hsp", "riga": 1819, "occorrenza": 0, "jp": "期待している", "jp_grezzo": "\"期待している\"", "en": "I'm counting on you.", "en_grezzo": "\"I'm counting on you.\"", "tipo": "statica", "contesto": "", "it": "Conto su di te."}
