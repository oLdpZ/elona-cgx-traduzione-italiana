{"firma": "da2c4967ffffe48f59a4a52853f92a7eb7c3ac95", "file": "text.hsp", "riga": 1825, "occorrenza": 0, "jp": "興味ない", "jp_grezzo": "\"興味ない\"", "en": "I'm not interested in you.", "en_grezzo": "\"I'm not interested in you.\"", "tipo": "statica", "contesto": "", "it": "Non mi interessi."}
{"firma": "ce97cec3ee9a9f6cc1ab9747be8449976c9b6edb", "file": "text.hsp", "riga": 1828, "occorrenza": 0, "jp": "邪魔", "jp_grezzo": "\"邪魔\"", "en": "You're a real bother.", "en_grezzo": "\"You're a real bother.\"", "tipo": "statica", "contesto": "", "it": "Mi stai fra i piedi."}
