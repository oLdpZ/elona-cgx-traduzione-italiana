{"firma": "40bddc7d3b822ba4ae1615ae4d5636cb6dfacfb7", "file": "text.hsp", "riga": 9905, "occorrenza": 0, "jp": "[達成]", "jp_grezzo": "\"[達成]\"", "en": "[Done]", "en_grezzo": "\"[Done]\"", "tipo": "statica", "contesto": "", "it": "[Fatto]"}
{"firma": "d7673498523d59b37364142b2ff3e3748273608a", "file": "text.hsp", "riga": 9910, "occorrenza": 0, "jp": "・何か飲み物を飲もう。", "jp_grezzo": "\"・何か飲み物を飲もう。\"", "en": "I will drink something.", "en_grezzo": "\"I will drink something.\"", "tipo": "statica", "contesto": "", "it": "・Bere qualcosa."}
{"firma": "ffc8a89dd18b79636d73207113fff56c4cf4b1be", "file": "text.hsp", "riga": 9915, "occorrenza": 0, "jp": "・ワールドマップを歩こう。", "jp_grezzo": "\"・ワールドマップを歩こう。\"", "en": "I will walk on the world map.", "en_grezzo": "\"I will walk on the world map.\"", "tipo": "statica", "contesto": "", "it": "・Camminare sulla mappa del mondo."}
{"firma": "b496155b7e347fd569bff0b27666a13f05633ceb", "file": "text.hsp", "riga": 9920, "occorrenza": 0, "jp": "・誰かと会話しよう。", "jp_grezzo": "\"・誰かと会話しよう。\"", "en": "I wll have a conversation with someone.", "en_grezzo": "\"I wll have a conversation with someone.\"", "tipo": "statica", "contesto": "", "it": "・Fare conversazione con qualcuno."}
{"firma": "fd2248cb2f39c9c787b5107c1b47d8d366a36a1c", "file": "text.hsp", "riga": 9925, "occorrenza": 0, "jp": "・高レベルの相手を倒そう。", "jp_grezzo": "\"・高レベルの相手を倒そう。\"", "en": "I will defeat a higher level enemy.", "en_grezzo": "\"I will defeat a higher level enemy.\"", "tipo": "statica", "contesto": "", "it": "・Abbattere un nemico di livello più alto."}
{"firma": "2adc4fc0d97ddd2ef1ba0bf9d707f2098aa7f6b4", "file": "text.hsp", "riga": 9930, "occorrenza": 0, "jp": "・誰かに自分の気持ちを伝えよう。", "jp_grezzo": "\"・誰かに自分の気持ちを伝えよう。\"", "en": "I will tell someone how I feel.", "en_grezzo": "\"I will tell someone how I feel.\"", "tipo": "statica", "contesto": "", "it": "・Dire a qualcuno quello che si prova."}
{"firma": "a0be1886700df06b69b437529c0bbc8ac941fb2a", "file": "text.hsp", "riga": 9935, "occorrenza": 0, "jp": "・ランダムネフィアを訪れよう。", "jp_grezzo": "\"・ランダムネフィアを訪れよう。\"", "en": "I will visit a Random Nefia.", "en_grezzo": "\"I will visit a Random Nefia.\"", "tipo": "statica", "contesto": "", "it": "・Visitare una Nefia casuale."}
{"firma": "5771fd7bb55da60d01faff498694a09a72fe066f", "file": "text.hsp", "riga": 9940, "occorrenza": 0, "jp": "・野外を訪れよう。", "jp_grezzo": "\"・野外を訪れよう。\"", "en": "I will visit the Wilderness.", "en_grezzo": "\"I will visit the Wilderness.\"", "tipo": "statica", "contesto": "", "it": "・Visitare le Terre selvagge."}
{"firma": "08b1d6f7218012a1722045d94f23f44b5469b82e", "file": "text.hsp", "riga": 9945, "occorrenza": 0, "jp": "・軽疲労になるまで運動しよう。", "jp_grezzo": "\"・軽疲労になるまで運動しよう。\"", "en": "I will exercise until I feel somewhat tired.", "en_grezzo": "\"I will exercise until I feel somewhat tired.\"", "tipo": "statica", "contesto": "", "it": "・Fare esercizio fino alla Stanchezza."}
{"firma": "02a2b28071a4c9b84d568de60a51c99e7db351fa", "file": "text.hsp", "riga": 9956, "occorrenza": 0, "jp": "・肉を食べよう。", "jp_grezzo": "\"・肉を食べよう。\"", "en": "I will eat some meat.", "en_grezzo": "\"I will eat some meat.\"", "tipo": "statica", "contesto": "", "it": "・Mangiare della carne."}
{"firma": "dea804d0d3370b6659687ae4fb97df6c6e5d007e", "file": "text.hsp", "riga": 9961, "occorrenza": 0, "jp": "・卵を食べよう。", "jp_grezzo": "\"・卵を食べよう。\"", "en": "I will eat an egg.", "en_grezzo": "\"I will eat an egg.\"", "tipo": "statica", "contesto": "", "it": "・Mangiare un uovo."}
{"firma": "f6f503bee3e8956ce74ff37fb2f942e31aca5a17", "file": "text.hsp", "riga": 9966, "occorrenza": 0, "jp": "・野菜を食べよう。", "jp_grezzo": "\"・野菜を食べよう。\"", "en": "I will eat some vegetable.", "en_grezzo": "\"I will eat some vegetable.\"", "tipo": "statica", "contesto": "", "it": "・Mangiare della verdura."}
{"firma": "97734b1666d6a195655a9cb900b9e628efc19f25", "file": "text.hsp", "riga": 9971, "occorrenza": 0, "jp": "・果物を食べよう。", "jp_grezzo": "\"・果物を食べよう。\"", "en": "I will eat some fruit.", "en_grezzo": "\"I will eat some fruit.\"", "tipo": "statica", "contesto": "", "it": "・Mangiare della frutta."}
{"firma": "e5d7f1602aefe956c5661b639437de7558006e2d", "file": "text.hsp", "riga": 9976, "occorrenza": 0, "jp": "・パンを食べよう。", "jp_grezzo": "\"・パンを食べよう。\"", "en": "I will eat some bread.", "en_grezzo": "\"I will eat some bread.\"", "tipo": "statica", "contesto": "", "it": "・Mangiare del pane."}
{"firma": "1790ae774ead85cd50941929553a68a69323f9bc", "file": "text.hsp", "riga": 9981, "occorrenza": 0, "jp": "・木の実を食べよう。", "jp_grezzo": "\"・木の実を食べよう。\"", "en": "I will eat some nuts.", "en_grezzo": "\"I will eat some nuts.\"", "tipo": "statica", "contesto": "", "it": "・Mangiare frutta secca."}
{"firma": "c8c644acb1236b2611c95ea806118a196efacd45", "file": "text.hsp", "riga": 9986, "occorrenza": 0, "jp": "・魚介を食べよう。", "jp_grezzo": "\"・魚介を食べよう。\"", "en": "I will eat some seafood.", "en_grezzo": "\"I will eat some seafood.\"", "tipo": "statica", "contesto": "", "it": "・Mangiare pesce o frutti di mare."}
