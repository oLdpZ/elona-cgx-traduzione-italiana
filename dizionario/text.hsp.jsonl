{"firma": "66327a699a81e97bc11b6f4525ea835ab5b83d43", "file": "text.hsp", "riga": 276, "occorrenza": 0, "jp": "相手が市民は。", "jp_grezzo": "\"相手が市民は。\"", "en": "  a lawful citizen of this peaceful town.", "en_grezzo": "cnven(he(tc, 1)) + \" \" + is(tc) + \" a lawful citizen of this peaceful town.\"", "tipo": "dinamica", "contesto": "\t\ts = lang(\"相手が市民は。\", cnven(he(tc, 1)) + \" \" + is(tc) + \" a lawful citizen of this peaceful town.\")", "it": "cnven(he(tc, 1)) + \" rispetta la legge di questa pacifica città.\""}
{"firma": "7ca61ebb1c0b0bd8c8c60deef13b2a23d859d338", "file": "text.hsp", "riga": 278, "occorrenza": 0, "jp": "相手がサービスを提供する人である。", "jp_grezzo": "\"相手がサービスを提供する人である。\"", "en": "  a hard-working citizen who provides specialty services.", "en_grezzo": "cnven(he(tc, 1)) + \" \" + is(tc) + \" a hard-working citizen who provides specialty services.\"", "tipo": "dinamica", "contesto": "\t\t\ts = lang(\"相手がサービスを提供する人である。\", cnven(he(tc, 1)) + \" \" + is(tc) + \" a hard-working citizen who provides specialty services.\")", "it": "cnven(he(tc, 1)) + \" lavora sodo e offre servizi specializzati.\""}
{"firma": "5ac6ef8446c70e632f5e2a3eb2cff10bae3dc63b", "file": "text.hsp", "riga": 281, "occorrenza": 0, "jp": "相手が冒険者は。", "jp_grezzo": "\"相手が冒険者は。\"", "en": "  a fellow adventurer.", "en_grezzo": "cnven(he(tc, 1)) + \" \" + is(tc) + \" a fellow adventurer.\"", "tipo": "dinamica", "contesto": "\t\t\ts = lang(\"相手が冒険者は。\", cnven(he(tc, 1)) + \" \" + is(tc) + \" a fellow adventurer.\")", "it": "cnven(he(tc, 1)) + \" gira il mondo in cerca di avventura, come te.\""}
{"firma": "581d93005c57b793bd8eaaa0ab838d6bbd4896f0", "file": "text.hsp", "riga": 284, "occorrenza": 0, "jp": "相手がこの町の安全を守っている。", "jp_grezzo": "\"相手がこの町の安全を守っている。\"", "en": "  keeping this town safe and clean.", "en_grezzo": "cnven(he(tc, 1)) + \" \" + is(tc) + \" keeping this town safe and clean.\"", "tipo": "dinamica", "contesto": "\t\t\ts = lang(\"相手がこの町の安全を守っている。\", cnven(he(tc, 1)) + \" \" + is(tc) + \" keeping this town safe and clean.\")", "it": "cnven(he(tc, 1)) + \" tiene questa città sicura e pulita.\""}
{"firma": "5d2be57f35ebb5c365d9cb0b1d7b8626b0e9ffd9", "file": "text.hsp", "riga": 287, "occorrenza": 0, "jp": "相手が各種商品の販売業者。", "jp_grezzo": "\"相手が各種商品の販売業者。\"", "en": "  a hard-working vender of assorted goods.", "en_grezzo": "cnven(he(tc, 1)) + \" \" + is(tc) + \" a hard-working vender of assorted goods.\"", "tipo": "dinamica", "contesto": "\t\t\ts = lang(\"相手が各種商品の販売業者。\", cnven(he(tc, 1)) + \" \" + is(tc) + \" a hard-working vender of assorted goods.\")", "it": "cnven(he(tc, 1)) + \" lavora sodo e vende ogni sorta di merce.\""}
